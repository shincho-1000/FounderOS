# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=founderos
POSTGRES_PASSWORD=founderos
POSTGRES_DB=founderos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://founderos:founderos@localhost:5432/founderos

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=founderos

# ── News APIs (pick one or more) ──────────────────────────────────────────────
NEWSDATA_API_KEY=your-newsdata-api-key
GDELT_ENABLED=false
DUCKDUCKGO_ENABLED=true

# ── LlamaIndex / Vector Store ─────────────────────────────────────────────────
LLAMA_INDEX_STORAGE_DIR=./storage
EMBED_MODEL=models/text-embedding-004

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
