# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# ── Memory (Phase 4) ──────────────────────────────────────────────────────────
SHORT_TERM_WINDOW=10
LONG_TERM_TOP_K=8
SUMMARY_MAX_CHARS=1500

# ── SQLite ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./founderos.db

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGO_DB=founderos

# ── News APIs (Phase 5 - GDELT DOC 2.0, no API key required) ─────────────────
NEWS_PROVIDER=gdelt
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_CACHE_TTL_SECONDS=1800
NEWS_TIMESPAN=7d
NEWS_MAX_RECORDS=10
NEWS_HTTP_TIMEOUT_SECONDS=10
NEWS_MIN_REQUEST_INTERVAL=5.5
NEWS_LANGUAGE=english
NEWSDATA_API_KEY=

# ── LlamaIndex ────────────────────────────────────────────────────────────────
LLAMA_INDEX_STORAGE_DIR=./storage
EMBED_MODEL=models/text-embedding-004

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
